#!/bin/sh
# Author: Mat Allen
# omniSearch-img: omnisearch-img	-- Image search via self-hosted OmniSearch (localhost:5000)
. surfraw || exit 1

w3_usage_hook () {
    cat <<EOF
Usage: $w3_argv0 [options] [search-string]
Description:
  Image search via self-hosted OmniSearch metasearch engine
Example:
  omniSearch-img drone build guide
EOF
    w3_global_usage
}

w3_config
w3_parse_args "$@"
if test -z "$w3_args"; then
    w3_browse_url "http://localhost:5000/images"
else
    escaped_args=`w3_url_of_arg $w3_args`
    w3_browse_url "http://localhost:5000/images?q=${escaped_args}"
fi
